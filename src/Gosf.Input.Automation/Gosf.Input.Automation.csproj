<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Gosf.Input.Automation</PackageId>
    <Version>0.1.0</Version>
    <Authors>Gosf.Input.Automation contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gaoshang212/Gosf.Input.Automation</RepositoryUrl>
    <PackageProjectUrl>https://github.com/gaoshang212/Gosf.Input.Automation</PackageProjectUrl>
    <Description>Windows foreground and background mouse and keyboard automation.</Description>
    <PackageTags>windows;automation;mouse;keyboard;input</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md for release history.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/NATIVE-REBUILD.md" Pack="true" PackagePath="docs/" />
    <None Include="build/Gosf.Input.Automation.targets" Pack="true" PackagePath="build/net462/;buildTransitive/net462/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../licenses/op.txt;../../licenses/blackbone.txt;../../licenses/asmjit.txt;../../licenses/minhook.txt;../../licenses/wow64ext-lgpl-3.0.txt;../../licenses/gpl-3.0.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../artifacts/gosf-input-automation-native-x64/Release/Gosf.Input.Automation.Native.x64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="../../artifacts/gosf-input-automation-native-x86/Release/Gosf.Input.Automation.Native.x86.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Pack="true" PackagePath="runtimes/win-x86/native/" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net462'">
    <_GosfNativeX86>$(MSBuildProjectDirectory)/../../artifacts/gosf-input-automation-native-x86/Release/Gosf.Input.Automation.Native.x86.dll</_GosfNativeX86>
    <_GosfNativeX64>$(MSBuildProjectDirectory)/../../artifacts/gosf-input-automation-native-x64/Release/Gosf.Input.Automation.Native.x64.dll</_GosfNativeX64>
  </PropertyGroup>
  <Import Project="build/Gosf.Input.Automation.targets" Condition="'$(TargetFramework)' == 'net462'" />
  <Target Name="RequireNativeBackends" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../artifacts/gosf-input-automation-native-x64/Release/Gosf.Input.Automation.Native.x64.dll') Or !Exists('../../artifacts/gosf-input-automation-native-x86/Release/Gosf.Input.Automation.Native.x86.dll')" Text="Run scripts/build-native.ps1 to build the x86 and x64 native backends before building the .NET project." />
  </Target>
</Project>
